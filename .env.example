# Tip: run `python -m navidrome_tidal_proxy.setup` to generate this file interactively. A .env here is loaded automatically.
# Where the real Navidrome lives (the proxy forwards everything to it)
NAVIDROME_URL=http://localhost:4533
# merge = always add Tidal results, minus anything your library already has; fallback = only when Navidrome finds no songs; off = pure passthrough
TIDAL_MODE=merge
# redirect = 302 to Tidal's CDN URL; proxy = stream bytes through this server
STREAM_MODE=redirect
# low_96k | low_320k | high_lossless | hi_res_lossless (hi-res may be DASH and unsupported)
TIDAL_QUALITY=hi_res_lossless
TIDAL_SESSION_FILE=./tidal-session-pkce.json
# How many Tidal hits to fetch per search before removing duplicates of your library and slicing to what the client asked for (max ~300)
TIDAL_LIMIT=200
# Keep loopback unless behind https or a private network (tailscale serve etc.): Subsonic clients send credentials in the URL
HOST=127.0.0.1
PORT=4534
# Lossless tracks are stitched into FLAC files here; least recently used are deleted beyond the size cap
CACHE_DIR=./cache
CACHE_MAX_GB=4
# Stamp a "T" on Tidal cover art so it is distinguishable from local music (0 to disable)
TIDAL_BADGE=1
# Warm the cache with the next album track while one plays (0 to disable)
PREFETCH=1
# OPT-IN: starring a Tidal track/album copies the FLAC into LIBRARY_DIR/Tidal/Artist/Album/ and rescans Navidrome.
# Downloading from Tidal may violate their terms; enable only if you accept that.
LIBRARY_DIR=
SAVE_ON_STAR=0
# Comma-separated Navidrome usernames allowed to use your Tidal account (empty = every valid Navidrome user)
TIDAL_USERS=
# Save-to-library safety: stop saving when the library disk has less than this free, and cap tracks per star
SAVE_MIN_FREE_GB=5
MAX_SAVE_TRACKS=200
LOG_LEVEL=INFO
